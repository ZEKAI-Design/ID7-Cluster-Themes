{
  "id": "zekai_cluster_themes",
  "title": "ID7 Cluster Themes",
  "vendor": "ZEKAI Design",
  "version": "0.8.5",
  "loggingId": "ZCT1",
  "description": "Persistent, auto-starting instrument themes for BMW iDrive 7. Choose a theme in the app; select BMW original to turn the overlay off.",
  "autostart": true,
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7"
  ],
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "ID7 Cluster Themes",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Customize"
        ],
        [
          "BTN_APPLY",
          "Enable selected theme"
        ],
        [
          "BTN_RESTORE",
          "BMW original"
        ]
      ]
    }
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "statusBordcomputerAverage": "rs",
      "statusBordcomputerTravelData": "rs",
      "_optional": "Fuel range, odometer and trip economy"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusNewCurrentUnitsStatusExt": "rs",
      "_optional": "Tyre pressure unit"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "_optional": "Tyre pressures"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s",
      "_optional": "Outside temperature"
    }
  },
  "settings": [
    {
      "key": "clusterOverlayEnabled",
      "label": "Start selected theme at boot",
      "type": "bool",
      "default": true
    },
    {
      "key": "instrumentTheme",
      "label": "Instrument theme",
      "type": "choice",
      "default": "five",
      "options": [
        [
          "stock",
          "BMW original"
        ],
        [
          "five",
          "Five Dial"
        ],
        [
          "silver",
          "Silver Trio"
        ],
        [
          "digital",
          "Digital"
        ],
        [
          "wazeFull",
          "Waze Full Map"
        ],
        [
          "vdoRetro",
          "VDO Retro 2000"
        ]
      ]
    },
    {
      "key": "five_faceColour",
      "label": "Five Dial / Face colour",
      "type": "choice",
      "default": "navy",
      "when": {
        "instrumentTheme": "five"
      },
      "options": [
        ["navy", "Original navy"],
        ["blue", "Slate blue"],
        ["teal", "Petrol green"],
        ["magenta", "Magenta"],
        ["red", "Red centre ring"]
      ]
    },
    {
      "key": "five_speedPosition",
