{
  "id": "zekai_cluster_themes",
  "title": "Cluster Themes",
  "vendor": "ZEKAI Design",
  "version": "0.7.1",
  "loggingId": "ZCT1",
  "description": "Five Dial, Silver Trio and Digital themes with a 12-second parked instrument preview. Optional Waze map with a compatible renderer; live BMW media unavailable.",
  "iconGlyph": "gauge",
  "mguHmi": [
    "ID7"
  ],
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Cluster Themes",
      "buttons": [
        [
          "BTN_SETTINGS",
          "Customize"
        ],
        [
          "BTN_APPLY",
          "Preview on cluster"
        ],
        [
          "BTN_RESTORE",
          "BMW original"
        ]
      ]
    }
  ],
  "signals": {
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs"
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "statusLateralAccelerationMassCenter": "rs",
      "statusLongitudinalAccelerationMassCenter": "rs",
      "_optional": "G meter"
    },
    "de.bmw.infotainment.KombiIF": {
      "statusRangeTankStatus": "rs",
      "_optional": "Fuel range"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusNewCurrentUnitsStatusExt": "rs",
      "_optional": "Tyre pressure unit"
    },
    "de.bmw.infotainment.vehicle.TPMS": {
      "statusTyrePressure": "rs",
      "_optional": "Tyre pressures"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "ExteriorTemperature": "s",
      "_optional": "Outside temperature"
    }
  },
  "settings": [
